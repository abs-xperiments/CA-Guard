# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — never commit
.env
.env.*
!.env.example

# Data — generated and downloaded datasets are never committed (data/SOURCES.md)
data/generated/
data/external/
data/cache/
*.parquet
*.xlsx
!tests/fixtures/**/*.xlsx

# Node / Next.js (Phase 6)
node_modules/
.next/
out/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local review database — a firm's decisions, never committed
data/review.db
data/*.db

# Session signing key — generated per installation on first run, never shared
data/session.key
*.key
